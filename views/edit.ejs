<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task</title>
</head>
<body>
    <form action="/task/edit/<%= id %>" method="POST">
        <label>Title:</label>
        <input type="text" id="title" name="title" required value="<%= title %>">
        <br>

        <label>Description:</label>
        <input type="text" id="description" name="description" required value="<%= description %>">
        <br>

        <label>Due Date:</label>
        <input type="date" id="dueDate" name="dueDate" required value="<%= dueDate ? dueDate.toISOString().split('T')[0] : '' %>">
        <br>

        <button type="submit">Edit Task</button>    
    </form>
    <br>

    <a href="/tasks">Back to Tasks</a>
</body>
</html>